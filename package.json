{
  "name": "ccc-morph",
  "version": "0.1.0",
  "description": "A transparent PTY wrapper with configurable keyboard shortcuts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pty",
    "terminal",
    "wrapper",
    "keyboard-shortcuts",
    "cli",
    "bun",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/closetheloop-dev/ccc-morph"
  },
  "homepage": "https://github.com/closetheloop-dev/ccc-morph#readme",
  "bugs": {
    "url": "https://github.com/closetheloop-dev/ccc-morph/issues"
  },
  "author": "closetheloop-dev",
  "bin": {
    "ccc-morph": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "build": "docker build --build-arg VERSION=v$npm_package_version --target export --output type=local,dest=dist .",
    "build:local": "bun build ./src/cli.ts --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --define APP_VERSION=\"v$npm_package_version\" --outfile ./dist/ccc-morph"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
